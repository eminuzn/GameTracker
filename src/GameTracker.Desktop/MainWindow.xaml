<Window x:Class="GameTracker.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameTracker.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="GameTracker" Width="1260" Height="820" MinWidth="1020" MinHeight="680" Background="#0D111C" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">

 <Window.Resources>
 <DataTemplate x:Key="VersionBadgeTemplate">
   <DockPanel Margin="0,3,0,0" ToolTip="{Binding VersionTooltip}">
     <TextBlock x:Name="VersionWarningBadge" DockPanel.Dock="Right" Text="⚠" Foreground="#FFCA66" FontSize="14" FontWeight="Bold" Margin="5,0,0,0">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsOutdated}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <TextBlock x:Name="VersionLabel" FontSize="11" TextTrimming="CharacterEllipsis">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="{Binding VersionText}" /><Setter Property="Foreground" Value="#8E9AB3" /><Style.Triggers><DataTrigger Binding="{Binding IsOutdated}" Value="True"><Setter Property="Text" Value="{Binding LocalVersion, StringFormat=v{0} · Güncel değil}" /><Setter Property="Foreground" Value="#FFCA66" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
   </DockPanel>
 </DataTemplate>
 <DataTemplate x:Key="ListGameTemplate"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Height="126" CornerRadius="6" Background="#26334E" ClipToBounds="True"><Grid><TextBlock Text="{Binding Initials}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#90B2FF" /><Image Source="{Binding CoverPath}" Stretch="UniformToFill" /></Grid></Border>
          <StackPanel Grid.Column="1" Margin="18,8,12,0"><DockPanel><Button DockPanel.Dock="Right" Content="{Binding FavoriteGlyph}" ToolTip="{Binding FavoriteActionText}" Click="ToggleFavorite_Click" Padding="8,0" Margin="8,0,0,0" FontSize="23" Foreground="#FFCA66" Background="Transparent" /><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></DockPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VersionBadgeTemplate}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8" ToolTip="{Binding StatusText}">
              <Border x:Name="ExeWarningBadge" Width="20" Height="20" CornerRadius="10" Background="#522C38" Margin="0,0,7,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding NeedsExeSelection}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="!" Foreground="#FF8E9B" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock x:Name="GameStatusLabel" Text="{Binding StatusText}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#87A8EE" /><Style.Triggers><DataTrigger Binding="{Binding NeedsExeSelection}" Value="True"><Setter Property="Foreground" Value="#FF8E9B" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel>
            <TextBlock Text="{Binding LastPlayedText, StringFormat=Son oynama: {0}}" Foreground="#8E9AB3" FontSize="12" /><TextBlock Text="{Binding CoverStatus}" Foreground="#68758E" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding SizeText}" FontSize="16" HorizontalAlignment="Right" /><TextBlock Text="{Binding TimeText}" Foreground="#8E9AB3" Margin="0,7,0,0" HorizontalAlignment="Right" /></StackPanel>
        </Grid></DataTemplate>
 <DataTemplate x:Key="GridGameTemplate">
 <Grid Margin="10">
 <Grid.RowDefinitions><RowDefinition Height="200" /><RowDefinition Height="*" /></Grid.RowDefinitions>
 <Border Background="#111724" CornerRadius="8" ClipToBounds="True"><Grid>
 <TextBlock Text="{Binding Initials}" FontSize="36" FontWeight="Bold" Foreground="#90B2FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
 <Image Source="{Binding CoverPath}" Stretch="Uniform" />
 </Grid></Border>
 <Button Content="{Binding FavoriteGlyph}" ToolTip="{Binding FavoriteActionText}" Click="ToggleFavorite_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,1" Margin="5" FontSize="22" Foreground="#FFCA66" Background="#D9171C29" />
 <StackPanel Grid.Row="1" Margin="2,10,2,0">
 <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="40" ToolTip="{Binding Name}" />
 <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VersionBadgeTemplate}" />
 <StackPanel Orientation="Horizontal" Margin="0,4,0,8" ToolTip="{Binding StatusText}">
 <Border Width="18" Height="18" CornerRadius="9" Background="#522C38" Margin="0,0,6,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding NeedsExeSelection}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="!" Foreground="#FF8E9B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
 <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="#87A8EE" /><Style.Triggers><DataTrigger Binding="{Binding NeedsExeSelection}" Value="True"><Setter Property="Foreground" Value="#FF8E9B" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel>
 <DockPanel><TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Foreground="#C5D2EA" FontSize="12" /><TextBlock Text="{Binding TimeText}" Foreground="#8E9AB3" FontSize="12" TextTrimming="CharacterEllipsis" /></DockPanel>
 <TextBlock Text="{Binding LastPlayedText}" Foreground="#8E9AB3" FontSize="11" Margin="0,6,0,0" ToolTip="Son oynama" />
 <TextBlock Text="{Binding CoverStatus}" Foreground="#68758E" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
 </StackPanel>
 </Grid>
 </DataTemplate>
 <ItemsPanelTemplate x:Key="ListGamesPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
 <ItemsPanelTemplate x:Key="GridGamesPanel"><local:LibraryGridPanel Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" RowHeight="400" /></ItemsPanelTemplate>
 </Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border Background="#0D111C" BorderBrush="#283249" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Background="#111724" BorderBrush="#252D40" BorderThickness="0,0,0,1">
        <Grid Margin="16,0,5,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Background="#376BE6" CornerRadius="6" Width="25" Height="25" Margin="0,0,10,0"><TextBlock Text="G" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="GameTracker" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="YEREL KÜTÜPHANE" FontSize="10" Foreground="#71839F" Margin="16,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowControlButton}" ToolTip="Simge durumuna küçült" AutomationProperties.Name="Simge durumuna küçült" Click="MinimizeWindow_Click"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#A9B8D3" /></Button>
            <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowControlButton}" AutomationProperties.Name="Büyüt veya geri yükle" Click="MaximizeWindow_Click">
              <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE922;" /><Setter Property="Foreground" Value="#A9B8D3" /><Setter Property="ToolTip" Value="Büyüt" /><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Text" Value="&#xE923;" /><Setter Property="ToolTip" Value="Geri yükle" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Button>
            <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseButton}" ToolTip="Sistem tepsisine küçült · takip devam eder" AutomationProperties.Name="Sistem tepsisine küçült" Click="CloseWindow_Click"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#A9B8D3" /></Button>
          </StackPanel>
        </Grid>
      </Border>
  <Grid Grid.Row="1" Margin="28,22,28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="GAMETRACKER" FontSize="12" Foreground="#7FA7FF" FontWeight="Bold" /><TextBlock Text="Oyunların. Tek bir yerde." FontSize="30" FontWeight="SemiBold" Margin="0,7,0,6" /><TextBlock Text="Yerel kütüphane · hesap bağlantısı gerekmez" Foreground="#8E9AB3" /></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="＋ Oyun klasörü ekle" Click="AddRoot_Click" Background="#376BE6" /><Button Content="Yenile" Click="Rescan_Click" /><Button Content="Çıkış" Click="Exit_Click" /></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,24,0,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Oyun adıyla ara" />
      <TextBlock Grid.Column="1" x:Name="SummaryText" Margin="20,15,0,0" Foreground="#8E9AB3" />
      <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
        <TextBlock Text="Sıralama" Foreground="#8E9AB3" VerticalAlignment="Center" Margin="0,0,12,8" />
        <ComboBox x:Name="SortBox" Width="160" Height="38" Margin="0,0,12,8" SelectionChanged="Sort_Changed" AutomationProperties.Name="Oyun sıralaması">
          <ComboBoxItem Content="Oyun adı" />
          <ComboBoxItem Content="Son oynama" />
          <ComboBoxItem Content="Boyut" />
        </ComboBox>
        <Button x:Name="ReverseSortButton" Content="A → Z" MinWidth="140" Click="ReverseSort_Click" ToolTip="Sıralama yönünü ters çevir" />
        <CheckBox x:Name="FavoritesOnlyBox" Content="★ Yalnızca favoriler" Foreground="#E9EEF7" VerticalAlignment="Center" Margin="12,0,0,8" Checked="FavoritesOnly_Changed" Unchecked="FavoritesOnly_Changed" />
        <CheckBox x:Name="ExeSelectionOnlyBox" Content="!  Yalnızca exe seçilmeli" VerticalAlignment="Center" Margin="12,0,0,8" Checked="ExeSelectionOnly_Changed" Unchecked="ExeSelectionOnly_Changed" />
      </WrapPanel>
      <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,4">
        <Button x:Name="CheckVersionsButton" Content="↻  Sürüm güncelliğini kontrol et" DockPanel.Dock="Right" Click="CheckVersions_Click" ToolTip="Sürümü bilinen tüm oyunları Steam'in resmi güncelleme duyurularıyla karşılaştır" />
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <RadioButton x:Name="ListViewButton" Content="☰  Liste" GroupName="LibraryLayout" Style="{StaticResource ViewModeOptionStyle}" Checked="ViewMode_Changed" />
          <RadioButton x:Name="GridViewButton" Content="▦  Izgara" GroupName="LibraryLayout" Style="{StaticResource ViewModeOptionStyle}" Checked="ViewMode_Changed" />
        </StackPanel>
        <StackPanel x:Name="GridColumnOptions" Orientation="Horizontal" Margin="16,0,0,0">
          <TextBlock Text="Sütun" Foreground="#8E9AB3" VerticalAlignment="Center" Margin="0,0,10,0" />
          <RadioButton x:Name="ThreeColumnsButton" Content="3" GroupName="GridColumns" Style="{StaticResource ViewModeOptionStyle}" Checked="GridColumns_Changed" ToolTip="Yan yana 3 oyun" />
          <RadioButton x:Name="FourColumnsButton" Content="4" GroupName="GridColumns" Style="{StaticResource ViewModeOptionStyle}" Checked="GridColumns_Changed" ToolTip="Yan yana 4 oyun" />
        </StackPanel>
      </DockPanel>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
      <Grid><ListBox x:Name="GamesList" SelectionChanged="Game_Selected" MouseDoubleClick="Game_DoubleClick" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.Style><Style TargetType="ListBox"><Setter Property="ItemTemplate" Value="{StaticResource ListGameTemplate}" /><Setter Property="ItemsPanel" Value="{StaticResource ListGamesPanel}" /><Style.Triggers><DataTrigger Binding="{Binding IsGridView, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True"><Setter Property="ItemTemplate" Value="{StaticResource GridGameTemplate}" /><Setter Property="ItemsPanel" Value="{StaticResource GridGamesPanel}" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SelectionFrame" BorderThickness="1" BorderBrush="#252D40" Background="#171C29" CornerRadius="12"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionFrame" Property="Background" Value="#1D2638" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#7FA7FF" /></Trigger><DataTrigger Binding="{Binding IsGridView, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True"><Setter Property="Margin" Value="0,0,10,12" /></DataTrigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#6696FF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>

      </ListBox><TextBlock x:Name="EmptyText" Text="Oyun klasörünü ekleyerek başla.&#10;&#10;Her alt klasör bir oyun olarak taranacak." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="18" Foreground="#8E9AB3" IsHitTestVisible="False" /></Grid>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="OYUN DETAYI" FontSize="11" Foreground="#7FA7FF" FontWeight="Bold" /><TextBlock x:Name="DetailTitle" Text="Bir oyun seç" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,14" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailInfo" Foreground="#8E9AB3" TextWrapping="Wrap" Margin="0,0,0,15" />
        <Border x:Name="DetailExeWarning" Visibility="Collapsed" Background="#36202C" BorderBrush="#743746" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"><TextBlock Text="!  Oynamak için exe seçmelisin." Foreground="#FF8E9B" FontWeight="SemiBold" TextWrapping="Wrap" /></Border>
        <Button x:Name="PlayButton" Content="▶  Oyna" Background="#376BE6" Click="Play_Click" />
        <Button x:Name="FavoriteButton" Content="☆ Favorilere ekle" Click="ToggleFavorite_Click" IsEnabled="False" Foreground="#FFCA66" />
        <WrapPanel><Button Content="Exe seç" Click="SelectExe_Click" /><Button Content="Takip exe'si" Click="SelectRuntime_Click" /><Button Content="Klasörü aç" Click="OpenFolder_Click" /></WrapPanel>
        <TextBlock Text="Oyun adı" Foreground="#8E9AB3" /><TextBox x:Name="NameBox" />
        <TextBlock Text="Oyun sürümü" Foreground="#8E9AB3" /><TextBox x:Name="VersionBox" MaxLength="80" ToolTip="Örneğin 2.31. Elle düzenlediğin sürüm taramalarda korunur. Değişiklikleri kaydet düğmesini kullan." />
        <TextBlock x:Name="VersionSourceText" Foreground="#68758E" FontSize="11" Margin="0,0,0,6" />
        <TextBlock x:Name="VersionCheckText" Foreground="#8E9AB3" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
        <WrapPanel><Button x:Name="CheckVersionButton" Content="Sürümü kontrol et" Click="CheckVersion_Click" /><Button x:Name="DetectVersionButton" Content="Sürümü algıla" Click="DetectVersion_Click" ToolTip="Elle girilen değeri bırak ve dosyalardan yeniden algıla" /></WrapPanel>
        <Button x:Name="VersionNewsButton" Content="Steam güncelleme duyurusunu aç" Click="VersionNews_Click" />
        <TextBlock Text="Başlatma argümanları" Foreground="#8E9AB3" /><TextBox x:Name="ArgsBox" />
        <TextBlock Text="Çalışma dizini (boş: exe'nin dizini)" Foreground="#8E9AB3" /><TextBox x:Name="WorkingBox" />
        <Button Content="Değişiklikleri kaydet" Click="SaveDetails_Click" />
        <WrapPanel><Button x:Name="ManualCoverButton" Content="Kapak değiştir…" Click="ManualCover_Click" /><Button x:Name="RetryCoverButton" Content="Kapağı yeniden ara" Click="RetryCover_Click" /></WrapPanel>
        <Button x:Name="ShoppingSearchButton" Content="Google Shopping’de kapak ara" Click="ShoppingSearch_Click" />
        <Button Content="Listeden kaldır" Click="Hide_Click" />
        <Button Content="Gizli oyunları geri göster" Click="RestoreHidden_Click" />
        <Button Content="Klasörü yeniden bağla…" Click="Rebind_Click" />
        <Button Content="Oyun klasörünü sil…" Background="#522C38" Click="Delete_Click" />
        <TextBlock Text="SON OTURUMLAR" Margin="0,15,0,10" FontSize="11" Foreground="#7FA7FF" /><TextBlock x:Name="SessionsText" TextWrapping="Wrap" Foreground="#8E9AB3" />
        <TextBlock x:Name="AttributionText" Margin="0,18,0,5" Foreground="#8E9AB3" TextWrapping="Wrap" /><Button Content="Kapak kaynağını aç" Click="Attribution_Click" />
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Hazır" Foreground="#8E9AB3" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" x:Name="CancelButton" Content="Taramayı durdur" Click="CancelScan_Click" Visibility="Collapsed" /></Grid>
  </Grid>
    </Grid>
  </Border>
</Window>
