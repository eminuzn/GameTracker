<Window x:Class="GameTracker.Desktop.ExePicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Oyun exe'sini seç" Width="760" Height="480" Background="#0D111C" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Name="TitleText" FontSize="22" Margin="0,0,0,18" /><ListBox Grid.Row="1" x:Name="CandidatesList" Background="#171C29" Foreground="#E9EEF7" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding RelativePath}" FontSize="15" /><TextBlock Text="{Binding Reason}" Foreground="#8E9AB3" TextWrapping="Wrap" /><TextBlock Text="{Binding Score, StringFormat=Tahmin skoru: {0}}" Foreground="#7FA7FF" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Dosyadan seç…" Click="Browse_Click" /><Button Content="Seçili exe'yi kullan" Click="Confirm_Click" Background="#376BE6" /><Button Content="Daha sonra" Click="Cancel_Click" /></StackPanel></Grid>
</Window>
