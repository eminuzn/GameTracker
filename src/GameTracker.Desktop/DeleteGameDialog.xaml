<Window x:Class="GameTracker.Desktop.DeleteGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oyunu sil" Width="700" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Margin="14" Background="#171C29" BorderBrush="#35405A" BorderThickness="1" CornerRadius="14">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="3" Opacity="0.45" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="20,0,8,0">
        <TextBlock Text="OYUNU SİL" Foreground="#FF8E9B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" MouseLeftButtonDown="Title_MouseDown" />
        <Button x:Name="CloseDialogButton" HorizontalAlignment="Right" Style="{StaticResource WindowCloseButton}" Click="Cancel_Click" ToolTip="İptal" AutomationProperties.Name="İptal">
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#A9B8D3" />
        </Button>
      </Grid>
      <StackPanel Grid.Row="1" Margin="26,6,26,26">
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Width="40" Height="40" Background="#36202C" CornerRadius="10" VerticalAlignment="Top">
            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#FF8E9B" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="GameNameText" FontSize="23" FontWeight="SemiBold" Foreground="#E9EEF7" TextWrapping="Wrap" MaxHeight="88" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Oyun klasörü nasıl kaldırılsın?" Foreground="#8E9AB3" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
        <Border Background="#111724" CornerRadius="8" Padding="12" Margin="0,0,0,16">
          <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="FolderPathText" Foreground="#A9B8D3" FontSize="12" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
        <TextBlock Text="Tüm oyun klasörü ve içindeki kayıt dosyaları kaldırılır. Oynama geçmişin korunur." Foreground="#A9B8D3" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="Tamamen sil işlemi geri alınamaz. Geri dönüşüme taşımak disk alanını hemen boşaltmaz." Foreground="#FFCA66" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,24" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button x:Name="PermanentButton" Content="Tamamen sil" Background="#69303E" Foreground="#FFD4DB" Margin="0" Padding="10,12" Click="Permanent_Click" />
          <Button x:Name="RecycleButton" Grid.Column="2" Content="Geri dönüşüme taşı" Background="#376BE6" Margin="0" Padding="10,12" Click="Recycle_Click" />
          <Button x:Name="CancelButton" Grid.Column="4" Content="İptal" Background="#283249" Margin="0" Padding="10,12" IsCancel="True" IsDefault="True" Click="Cancel_Click" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
